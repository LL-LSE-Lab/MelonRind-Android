{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melonrind.dev/schemas/android-signatures.schema.json",
  "title": "MelonRind Android ARM64 signature set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "minecraftVersion", "module", "signatures"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "minecraftVersion": {
      "type": "string",
      "pattern": "^1\\.26\\.(50|51|52)(\\.[0-9]+)?$"
    },
    "module": { "type": "string", "const": "libminecraftpe.so" },
    "architecture": { "type": "string", "const": "arm64-v8a" },
    "apkSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "librarySha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frame", "playerState", "hunger", "health", "mainHandFood", "attributeUpdate"],
      "properties": {
        "frame": { "type": "string" },
        "playerState": { "type": "string" },
        "hunger": { "type": "string" },
        "health": { "type": "string" },
        "mainHandFood": { "type": "string" },
        "attributeUpdate": { "type": "string" }
      }
    },
    "abi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkHandlerType": { "type": "string" },
        "attributeHandlerSlot": { "type": "integer", "minimum": 0 },
        "hungerShouldRenderOffset": { "type": ["integer", "string"] },
        "heartBackgroundCountOffset": { "type": ["integer", "string"] },
        "heartFullCountOffset": { "type": ["integer", "string"] },
        "heartHalfCountOffset": { "type": ["integer", "string"] },
        "playerInventoryOffset": { "type": ["integer", "string"] },
        "playerInventorySelectedOffset": { "type": ["integer", "string"] },
        "playerInventoryContainerOffset": { "type": ["integer", "string"] },
        "playerCarriedItemSlot": { "type": "integer", "minimum": 0 },
        "inventoryGetItemSlot": { "type": "integer", "minimum": 0 },
        "itemWeakCounterOffset": { "type": ["integer", "string"] },
        "itemNameStringOffset": { "type": ["integer", "string"] },
        "itemGetFoodSlot": { "type": "integer", "minimum": 0 },
        "foodNutritionSlot": { "type": "integer", "minimum": 0 },
        "foodSaturationSlot": { "type": "integer", "minimum": 0 },
        "foodAlwaysEatSlot": { "type": "integer", "minimum": 0 },
        "packetPayloadOffset": { "type": ["integer", "string"] },
        "attributeStride": { "type": ["integer", "string"] },
        "hungerIconPositionOffset": { "type": ["integer", "string"] },
        "hungerIconCount": { "type": "integer", "minimum": 0 },
        "hungerIconStride": { "type": ["integer", "string"] },
        "heartIconVectorOffset": { "type": ["integer", "string"] },
        "hungerRenderRva": { "type": ["integer", "string"] },
        "attributePacketCompleteDtorRva": { "type": ["integer", "string"] },
        "attributePacketDeletingDtorRva": { "type": ["integer", "string"] }
      }
    },
    "hudVtables": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hungerRendererType": {"type": "string"},
        "heartRendererType": {"type": "string"},
        "hungerRenderSlot": {"type": "integer", "minimum": 0},
        "heartRenderSlot": {"type": "integer", "minimum": 0}
      }
    },
    "notes": { "type": "string" }
  }
}
